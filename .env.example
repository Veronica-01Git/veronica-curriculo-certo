# ---------------------------------------------------------------------------
# VERONICA - Currículo Certo — variáveis de ambiente
# Copie este arquivo para ".env" e preencha com suas chaves reais.
# ---------------------------------------------------------------------------

# Banco de dados — PostgreSQL (ex: Neon)
# DATABASE_URL: conexão via pooler (usada pela aplicação em runtime)
# DIRECT_URL: conexão direta, sem pooler (usada apenas pelo Prisma Migrate)
DATABASE_URL="postgresql://usuario:senha@ep-xxxx-pooler.regiao.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://usuario:senha@ep-xxxx.regiao.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="gere-com: openssl rand -base64 32"

# OAuth (opcional — deixe em branco para usar apenas login por e-mail/senha)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# Stripe (assinaturas)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_MENSAL=""
STRIPE_PRICE_ID_ANUAL=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# IA para reescrita/otimização avançada do currículo (opcional, plugável)
# Suporta Anthropic (recomendado) ou OpenAI — deixe em branco para usar
# apenas o otimizador heurístico local (sem custo de API).
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# E-mail transacional (convites, recuperação de senha, recibos)
RESEND_API_KEY=""
EMAIL_FROM="VERONICA <contato@curriculocerto.app>"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
